# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below is also the in-code default,
# so an empty .env still boots a working development server.
# ---------------------------------------------------------------------------

# Free-form environment name: local | development | staging | production.
# Anything other than "production" enables /docs and verbose error payloads.
PSX_ENVIRONMENT=local
PSX_DEBUG=true

# SQLAlchemy URL. SQLite keeps local setup to zero steps.
# Postgres example: postgresql+psycopg://psx:psx@localhost:5432/psx_invest
PSX_DATABASE_URL=sqlite+pysqlite:///./psx_invest.db

# Comma-separated list of browser origins allowed to call the API.
PSX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market data provider to bind at startup: seeded | (future) psx_official
PSX_MARKET_DATA_PROVIDER=seeded

# Create tables and load reference/demo data on startup. Turn OFF in production
# and use Alembic migrations instead.
PSX_AUTO_MIGRATE=true
PSX_SEED_ON_STARTUP=true

# v1 runs single-user (no login). This is the seam where real auth plugs in;
# see app/api/deps.py::get_current_user.
PSX_DEFAULT_USER_EMAIL=investor@example.com
