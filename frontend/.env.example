# ---------------------------------------------------------------------------
# Copy to .env.local for local overrides. Both values below are also the
# in-code defaults, so an absent file still works.
# ---------------------------------------------------------------------------

# Base URL the app calls. Leave as "/api/v1" to use the Vite dev proxy (see
# vite.config.ts), which keeps requests same-origin in development.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api to.
VITE_PROXY_TARGET=http://127.0.0.1:8000
